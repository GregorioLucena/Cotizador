# Copiar a .env.development y ajustar valores locales.
# Ver docs/12-infraestructura-docker.md

# Base de datos
POSTGRES_USER=cotizador
POSTGRES_PASSWORD=cotizador
POSTGRES_DB=cotizador
DATABASE_URL=postgresql://cotizador:cotizador@localhost:5432/cotizador
DATABASE_SSL=false

# Autenticacion
JWT_SECRET=cambiar-con-openssl-rand-hex-32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
COOKIE_SAMESITE=lax

# API
API_PORT=3001
PORT=3001
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# IA (fase 0: desactivada)
IA_PROVEEDOR=none
IA_MODELO=
IA_TIMEOUT_MS=20000
IA_MAX_CARACTERES=4000

# Documentos
PDF_TIMEOUT_MS=30000
ALMACENAMIENTO_ARCHIVOS=local

# Semilla
RUN_SEED=true
SEED_ADMIN_EMAIL=admin@cotizador.local
SEED_ADMIN_PASSWORD=CambiarEnElPrimerAcceso1!
