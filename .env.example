# Plantilla versionada. Copiar a `.env.development` y completar.
# Ver docs/12-infraestructura-docker.md
#
# Regla: en este archivo las claves y secretos van vacíos.
# Valores de orientación (no secretos) viven en la guía de infraestructura.

# --- Base de datos ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
DATABASE_SSL=

# --- Autenticacion ---
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_DAYS=
COOKIE_SAMESITE=

# --- API ---
API_PORT=
PORT=
CORS_ORIGIN=
NODE_ENV=

# --- Web ---
WEB_PORT=
NEXT_PUBLIC_API_URL=

# --- IA ---
IA_PROVEEDOR=
IA_MODELO=
IA_TIMEOUT_MS=
IA_MAX_CARACTERES=
IA_TEMPERATURA=
IA_COSTO_ENTRADA_POR_1K=
IA_COSTO_SALIDA_POR_1K=
OPENAI_API_KEY=
OLLAMA_BASE_URL=

# --- Documentos ---
PDF_TIMEOUT_MS=
# auto | chromium | mock — auto usa Chrome/Chromium del sistema si existe
PDF_GENERADOR=
# Ruta al ejecutable (opcional; si no, se buscan rutas típicas / imagen Docker)
CHROMIUM_PATH=
ALMACENAMIENTO_ARCHIVOS=
UPLOAD_DIR=

# --- Semilla ---
RUN_SEED=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO=
SEED_DEMO_ADMIN_EMAIL=
SEED_DEMO_ADMIN_PASSWORD=
SEED_DEMO_COTIZADOR_EMAIL=
SEED_DEMO_COTIZADOR_PASSWORD=

# --- E2E (contraseñas YA cambiadas tras el primer acceso; no uses SEED_* aquí) ---
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_COTIZADOR_EMAIL=
E2E_COTIZADOR_PASSWORD=
E2E_PLATAFORMA_EMAIL=
E2E_PLATAFORMA_PASSWORD=
IA_PROVEEDOR_E2E=
PDF_GENERADOR_E2E=
