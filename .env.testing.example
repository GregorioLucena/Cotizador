# Plantilla para entorno testing (contenedores).
# Copiar a `.env.testing` y completar secretos. No versionar `.env.testing`.
# Ver docs/12-infraestructura-docker.md
#
# Arranque:
#   docker compose --env-file .env.testing -f docker-compose.yml up --build -d

# --- Base de datos ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Dentro de Compose la API sobrescribe DATABASE_URL hacia el servicio postgres.
# Fuera de Compose (PaaS), defina DATABASE_URL completo y POSTGRES_HOST si aplica.
DATABASE_URL=
DATABASE_SSL=false
POSTGRES_HOST=postgres

# --- Autenticacion ---
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
COOKIE_SAMESITE=lax

# --- API ---
API_PORT=3001
PORT=3001
# Origen público de la web (CORS)
CORS_ORIGIN=http://localhost:3000
NODE_ENV=testing

# --- Web ---
WEB_PORT=3000
# URL pública de la API (la usa el navegador; se inyecta al build de Next)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# --- IA ---
IA_PROVEEDOR=openai
IA_MODELO=gpt-4o-mini
IA_TIMEOUT_MS=20000
IA_MAX_CARACTERES=4000
IA_TEMPERATURA=0
IA_COSTO_ENTRADA_POR_1K=0.00015
IA_COSTO_SALIDA_POR_1K=0.0006
OPENAI_API_KEY=
OLLAMA_BASE_URL=

# --- Documentos ---
PDF_TIMEOUT_MS=30000
PDF_GENERADOR=chromium
CHROMIUM_PATH=/usr/bin/chromium-browser
ALMACENAMIENTO_ARCHIVOS=local
UPLOAD_DIR=/app/uploads

# --- Semilla (testing: true; production: false) ---
RUN_SEED=true
SEED_ADMIN_EMAIL=admin@cotizador.local
SEED_ADMIN_PASSWORD=
SEED_DEMO=true
SEED_DEMO_ADMIN_EMAIL=admin@demo.local
SEED_DEMO_ADMIN_PASSWORD=
SEED_DEMO_COTIZADOR_EMAIL=cotizador@demo.local
SEED_DEMO_COTIZADOR_PASSWORD=
