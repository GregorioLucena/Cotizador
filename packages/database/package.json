{
  "name": "@cotizador/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./entities": {
      "types": "./dist/entities/index.d.ts",
      "default": "./dist/entities/index.js"
    },
    "./enums": {
      "types": "./dist/enums.d.ts",
      "default": "./dist/enums.js"
    }
  },
  "typesVersions": {
    "*": {
      "entities": [
        "dist/entities/index.d.ts"
      ],
      "enums": [
        "dist/enums.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "db:migration:generate": "tsx ../../node_modules/typeorm/cli.js migration:generate -d dist/cli-data-source.js",
    "db:migration:run": "tsx ../../node_modules/typeorm/cli.js migration:run -d dist/cli-data-source.js",
    "db:migration:revert": "tsx ../../node_modules/typeorm/cli.js migration:revert -d dist/cli-data-source.js",
    "db:seed": "pnpm build && node dist/seeds/run-seed.js"
  },
  "dependencies": {
    "@cotizador/shared": "workspace:*",
    "bcryptjs": "^3.0.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.26"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
